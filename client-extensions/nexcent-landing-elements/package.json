    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@vitejs/plugin-react": "4.3.4",
    "sass": "1.89.2",
    "storybook": "^10.5.3",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vitest": "3.2.4"
